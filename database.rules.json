{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
        "played":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "wins":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/host').val() === auth.uid) || (data.exists() && data.child('meta/host').val() === auth.uid && !newData.exists()))",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['meta'])",

        "meta": {
          "host":      { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "status": {
            ".write": "auth != null && (root.child('rooms/' + $code + '/meta/host').val() === auth.uid || (newData.val() === 'finished' && root.child('rooms/' + $code + '/game/phase').val() === 'over' && root.child('rooms/' + $code + '/players/' + auth.uid).exists()))",
            ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
          },
          "$other": { ".validate": false }
        },

        "seats": {
          "$seat": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('rooms/' + $code + '/meta/status').val() === 'waiting') || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
            ".validate": "$seat.matches(/^[0-3]$/) && newData.isString()"
          }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms/' + $code + '/meta/status').val() === 'waiting')",
            ".validate": "newData.hasChildren(['name', 'ready'])",
            "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "ready":  { ".validate": "newData.isBoolean()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "game": {
          ".write": "auth != null && ((!data.exists() && root.child('rooms/' + $code + '/meta/host').val() === auth.uid && root.child('rooms/' + $code + '/meta/status').val() === 'playing') || data.child('turnUid').val() === auth.uid || (data.child('phase').val() === 'over' && root.child('rooms/' + $code + '/meta/host').val() === auth.uid) || (root.child('rooms/' + $code + '/players/' + data.child('turnUid').val() + '/online').val() === false && root.child('rooms/' + $code + '/players/' + auth.uid).exists()))",
          ".validate": "newData.hasChildren(['turn', 'turnUid', 'dice', 'phase', 'rev', 'ev', 'order', 'tokens']) && (!data.exists() ? newData.child('rev').val() === 0 : newData.child('rev').val() === data.child('rev').val() + 1)",
          "turn":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "turnUid":   { ".validate": "newData.isString() && root.child('rooms/' + $code + '/players/' + newData.val()).exists()" },
          "dice":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
          "phase":     { ".validate": "newData.isString() && (newData.val() === 'roll' || newData.val() === 'move' || newData.val() === 'over')" },
          "sixStreak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "winner":    { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 3" },
          "rev":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "ev":        { ".validate": "newData.isString() && (newData.val() === 'start' || newData.val() === 'roll' || newData.val() === 'move' || newData.val() === 'skip')" },
          "order": {
            "$i": { ".validate": "newData.isString() && root.child('rooms/' + $code + '/players/' + newData.val()).exists()" }
          },
          "tokens": {
            "$p": { "$t": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 56" } }
          },
          "last": {
            "p":    { ".validate": "newData.isNumber()" },
            "t":    { ".validate": "newData.isNumber()" },
            "from": { ".validate": "newData.isNumber()" },
            "to":   { ".validate": "newData.isNumber()" },
            "rev":  { ".validate": "newData.isNumber()" }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
